rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Schema Validation Helper
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'phoneNumber', 'emailVerified', 'phoneVerified', 'createdAt', 'updatedAt']) &&
        data.uid == request.auth.uid &&
        data.uid is string && data.uid.size() <= 128 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 50)) &&
        (!('emailVerified' in data) || data.emailVerified is bool) &&
        (!('phoneVerified' in data) || data.phoneVerified is bool) &&
        data.createdAt is string && data.createdAt.size() <= 100 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Global Safety Net Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile Collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().createdAt == existing().createdAt && incoming().uid == existing().uid;
      allow delete: if false;
    }
  }
}
